# ─────────────────────────────────────────────────────────────────────────────
# 生产环境变量模板
#
# ⚠️ 这份模板**不含任何真实凭据**，可以直接进仓库。
#    真正生效的是服务器上的 `.env.production`（gitignored），
#    由部署时从模板复制并填值。
#
# 填法：`cp .env.production.example .env.production && chmod 600 .env.production`
# ─────────────────────────────────────────────────────────────────────────────

# ── 对外身份 ─────────────────────────────────────────────────────────────────
# 必须是 https origin，**不能带路径、不能带端口、不能带尾斜杠**
REVIEW_PUBLIC_ORIGIN=https://ca.luteos.com

# ── 飞书 OAuth ───────────────────────────────────────────────────────────────
# App ID 必须以 `cli_` 开头（production_app.py 硬校验这个前缀）
REVIEW_OAUTH_CLIENT_ID=cli_REPLACE_ME
REVIEW_OAUTH_CLIENT_SECRET=REPLACE_ME
# 这两个必须**严格等于** origin + 固定路径，多一个字符启动就拒
REVIEW_OAUTH_REDIRECT_URI=https://ca.luteos.com/auth/callback
REVIEW_OAUTH_REAUTH_REDIRECT_URI=https://ca.luteos.com/auth/reauth/callback
# 逗号分隔；**不能为空**
REVIEW_TENANT_ALLOWLIST=REPLACE_ME

# ── 数据路径（容器内挂载点，不是宿主机路径）──────────────────────────────────
# 七个路径必须互不重叠，且不能落在 /app（仓库目录）里 —— ProductionSettings 会校验
REVIEW_AUTHORITY_ROOT=/data/authority
REVIEW_FROZEN_PROJECTION_ROOT=/data/projection
REVIEW_PROJECTION_DB=/data/db/review.db
REVIEW_API_SESSION_DB=/data/db/session.db
REVIEW_API_ACCESS_LOG=/data/logs/access.jsonl
REVIEW_PRINCIPAL_DIRECTORY=/data/principals.json
# T-316d：报告正文落盘根。报告含 IR 与依据 = 内容，不许落在 /app（仓库目录）
REVIEW_REPORT_ROOT=/data/reports-root
