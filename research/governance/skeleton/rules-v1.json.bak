    {
      "rule_key": "T2.1.2.pain-relief",
      "parent_rule": "H07",
      "topic": "T2.1.2",
      "topic_label": "疼痛缓解（人体结果）",
      "modality": "prohibit",
      "severity": "L4",
      "disposition": "auto_reject",
      "evaluability": "auto",
      "match": {
        "keywords": [
          "eliminates pain",
          "pain-free",
          "no pain ever",
          "completely painless",
          "100% pain",
          "完全不痛",
          "零疼痛",
          "无痛",
          "无痛吸奶",
          "painlessly",
          "painless",
          "pain relief",
          "relieve pain",
          "relieves pain",
          "relieved pain",
          "relief from pain",
          "stop the pain",
          "stops pain",
          "stop pain",
          "kill pain",
          "ends pain",
          "end pain",
          "less pain",
          "reduce pain",
          "reduces pain",
          "reduced pain",
          "pain solution",
          "solve pain",
          "pain gone",
          "缓解疼痛",
          "schmerzfrei",
          "sans douleur",
          "indolore",
          "sin dolor"
        ],
        "patterns": [
          "\\b(pain.?free|no\\s+pain|zero\\s+pain)\\b",
          "\\bwithout (the |any |much )?pain\\b",
          "(say )?goodbye to [^.!?|]*pain\\w*",
          "\\bno more pain\\w*\\b"
        ],
        "languages": [
          "en",
          "zh",
          "de",
          "fr",
          "it",
          "es"
        ]
      },
      "downgrade_band": {
        "keywords": [
          "comfort",
          "comfortable",
          "gentle",
          "gentler",
          "gently",
          "discomfort",
          "reduced discomfort",
          "reduce discomfort",
          "reduces discomfort",
          "relieve discomfort",
          "relieves discomfort",
          "easing discomfort",
          "ease discomfort",
          "soothe tension"
        ],
        "effect": "auto_reject → manual_review"
      },
      "evidence_required": "clinical",
      "source_legacy": "H07 关键词/正则（英文部分）",
      "detection_layer": "native",
      "$codified_note": [
        "★ 后 4 个关键词是 codified，不是 native：它们**不在**现行 H07 的关键词列，也不在其正则里。",
        "依据：现行 291 条记录中，人工复核已用 `H07:sans douleur` / `H07:schmerzfrei` / `H07:indolore` /",
        "`H07:sin dolor` 判定了 31 条，且 31/31 条的 `修改建议` 里显式写着这几个词（见 score.py 的 --audit-channel）。",
        "本骨架把这条**已经在运行但未入库的检测通道**显式化。这是 Q3 的答案，不是猜测。"
      ]
    },
    {
      "rule_key": "T2.1.3.milk-flow",
      "parent_rule": "M07",
      "topic": "T2.1.3",
      "topic_label": "排空 / 奶阵 / 奶流",
      "modality": "review",
      "severity": "L2",
      "disposition": "manual_review",
      "evaluability": "auto_then_manual",
      "match": {
        "keywords": [
          "reduce milk leakage",
          "reduces milk leakage",
          "reduce leakage",
          "leakage",
          "leak",
          "leak-proof pumping",
          "leak proof",
          "leak none",
          "higher pumping efficiency",
          "improve pumping efficiency",
          "improved pumping efficiency",
          "milk removal",
          "improve milk removal",
          "improved milk removal",
          "faster milk flow",
          "quicker milk flow",
          "improve milk flow",
          "better milk flow",
          "smoother milk flow",
          "smooth milk flow",
          "support milk flow",
          "减少漏奶",
          "防漏奶",
          "提升吸乳效率",
          "提高吸乳效率",
          "吸乳效率",
          "移除量",
          "奶量移除",
          "排乳更顺",
          "短时奶流",
          "奶流更顺",
          "前几分钟排乳",
          "排乳效率",
          "排乳更顺畅"
        ],
        "patterns": [
          "(higher|better|improve\\w*|increase\\w*|boost\\w*)[^.!?|]*(pumping efficiency|milk removal|milk flow|milk expression)",
          "(reduce|stop|prevent|anti)[^.!?|,]*leak\\w*",
          "leak none|no (more )?leak\\w*|leak-?proof",
          "(减少|防止|降低|杜绝)[^.!?|]*(漏奶)"
        ],
        "languages": [
          "en",
          "zh"
        ]
      },
      "downgrade_band": {
        "keywords": [],
        "effect": "none"
      },
      "evidence_required": "w1_self_controlled_data",
      "source_legacy": "M07（原关键词横跨 T2.1.3 与 T2.2.1）",
      "detection_layer": "native",
      "$added_note": "原 M02 有 8 关键词 0 正则，本骨架补 2 条正则。",
      "$codified_note": "M02 的 8 次漏报：英文 `strong suction`(3)、西语 `succión potente`(2)、意语记录中的英文词(3)。原表 8 词 0 正则，且只有最高级 `strongest suction` —— 漏了原级 `strong suction`。这是「规则只写最高级、不写原级」的结构性缺陷，与语种无关。",
      "$split_note": "★ 原 M07 的 32 个关键词含两族：`pumping efficiency`/`milk removal`/`milk flow`（过程侧）与 `reduce milk leakage`（生理侧）。原表把它们压在一条规则里且**无主题归属**，导致这 16 次命中在新模型下无处可挂。本骨架收拢到 T2.1.3。"
    },
    {
