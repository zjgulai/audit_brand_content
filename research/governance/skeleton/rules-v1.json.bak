{
  "$schema_version": "rules-v1",
  "$note": [
    "可执行规则库 v1。由 21 条现行规则（_data/rules_raw.json）重写而来。",
    "重写规则见 _data/REWRITE_NOTES.md。本文件是手工维护的判定源，score.py 只读不写。",
    "topic 字段必须与 topic-tree-v1.md 的节点名逐字一致，score.py 会校验。"
  ],
  "qualifier_axes": {
    "$note": "§0.3 的正交轴：修饰性极端词不占主题节点，单独标记。",
    "enum": [
      "safety",
      "performance",
      "quantity",
      "time",
      "exclusivity",
      "comparison",
      "none"
    ]
  },
  "detection_layers": {
    "$note": [
      "detection_layer 记录这条规则的关键词是怎么来的 —— 这是本骨架的可审计点。",
      "native    = 现行规则表里本来就有",
      "codified  = 现行规则表里没有，但**人工复核记录里已经在用**（把人的知识显式化）",
      "added     = 骨架新增（必须标注依据，否则不许加）"
    ],
    "enum": [
      "native",
      "codified",
      "added"
    ]
  },
  "rules": [
    {
      "rule_key": "T1.1.medical-cure",
      "parent_rule": "H01",
      "topic": "T1.1",
      "topic_label": "疾病治疗 / 治愈",
      "modality": "prohibit",
      "severity": "L4",
      "disposition": "auto_reject",
      "evaluability": "auto",
      "match": {
        "keywords": [
          "treat",
          "cure",
          "heal",
          "remedy",
          "diagnos",
          "治疗",
          "治愈",
          "诊断",
          "疗法",
          "根治"
        ],
        "patterns": [
          "\\b(treat|cure|heal|remedy|diagnos)\\w*\\b"
        ],
        "languages": [
          "en",
          "zh"
        ]
      },
      "downgrade_band": {
        "$note": "豁免词 = 降级信号，不是放行信号（设计文档 §F：免责声明不是许可证）",
        "keywords": [
          "treat yourself",
          "doesn't treat",
          "does not treat",
          "do not treat",
          "not intended to treat",
          "not to treat",
          "not a treatment",
          "not a medical device",
          "not intended to cure",
          "doesn't cure",
          "cannot cure",
          "can't cure"
        ],
        "effect": "auto_reject → manual_review"
      },
      "evidence_required": "regulatory_clearance_or_clinical",
      "source_legacy": "W1卖点表达边界 + 吸奶器广告文案审计_红绿灯.xlsx",
      "detection_layer": "native"
    },
    {
      "rule_key": "T1.2.medical-prevent",
      "parent_rule": "H02",
      "topic": "T1.2",
      "topic_label": "疾病预防",
      "modality": "prohibit",
      "severity": "L4",
      "disposition": "auto_reject",
      "evaluability": "auto",
      "match": {
        "keywords": [
          "prevent mastitis",
          "prevents mastitis",
          "prevent clogged",
          "prevent plugged",
          "stop mastitis",
          "乳腺炎",
          "预防乳腺炎"
        ],
        "patterns": [],
        "languages": [
          "en",
          "zh"
        ]
      },
      "downgrade_band": {
        "keywords": [
          "不能预防乳腺炎",
          "不可以预防乳腺炎",
          "cannot prevent",
          "reduce the risk of clogged",
          "risk of clogged"
        ],
        "effect": "auto_reject → manual_review"
      },
      "evidence_required": "regulatory_clearance_or_clinical",
      "source_legacy": "H02 边界内容第一段",
      "detection_layer": "native"
    },
    {
      "rule_key": "T1.5.duct-unclog",
      "parent_rule": "H01",
      "topic": "T1.5",
      "topic_label": "疏通 / 阻塞类病理叙事",
      "modality": "prohibit",
      "severity": "L4",
      "disposition": "auto_reject",
      "evaluability": "auto",
      "match": {
        "keywords": [
          "unclog",
          "unclog ducts",
          "unblock ducts",
          "clear clogged",
          "clear blocked",
          "fix clogged",
          "treat clogged",
          "treat plugged",
          "treat engorgement",
          "cure engorgement",
          "cure mastitis",
          "treat mastitis",
          "clogged duct treatment",
          "plugged duct treatment",
          "engorgement treatment",
          "堵奶",
          "通乳"
        ],
        "patterns": [
          "\\bunclog\\w*\\b",
          "(say )?goodbye to [^.!?|]*clog\\w*",
          "\\bno more clog\\w*\\b",
          "\\b(clear|fix)\\b (a |the |your )?(clogged|blocked)\\b"
        ],
        "languages": [
          "en",
          "zh"
        ]
      },
      "downgrade_band": {
        "keywords": [
          "ease engorgement",
          "relieve engorgement",
          "缓解涨奶"
        ],
        "effect": "auto_reject → manual_review"
      },
      "evidence_required": "regulatory_clearance_or_clinical",
      "source_legacy": "H01 边界内容",
      "detection_layer": "native"
    },
    {
      "rule_key": "T2.1.1.milk-supply",
