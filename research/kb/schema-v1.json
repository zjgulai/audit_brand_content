{
  "schema_version": "v1",
  "built_for": "需求知识库 · 本地分析账本",
  "authority": {
    "content_authority": "飞书源系统（本台账是投影，不是副本；冲突以源为准）",
    "decision_record": "ADR-0010",
    "design_doc": "research/kb/需求知识库-建设方案.md",
    "loader": "research/kb/load.py（唯一装载层）"
  },

  "record_key": "{source_system}:{source_table_id}:{source_record_id}",
  "fingerprint_fields": ["title", "product_line", "sku", "status_raw", "priority_raw",
                         "owner", "requester", "date_submitted", "date_due", "date_done"],

  "normalized_fields": [
    {"name": "record_key",        "type": "string", "note": "台账主键，稳定，由溯源三元组拼成"},
    {"name": "source_system",     "type": "enum",   "values": ["creative", "seo"]},
    {"name": "source_table",      "type": "string", "note": "源表名（中文原名，不翻译）"},
    {"name": "source_table_id",   "type": "string"},
    {"name": "source_record_id",  "type": "string", "note": "飞书 record_id"},
    {"name": "fingerprint",       "type": "string", "note": "sha256(fingerprint_fields)，用于判断'还是不是同一条'"},
    {"name": "level",             "type": "enum",   "values": ["top", "child"], "note": "由源表关联字段判定"},
    {"name": "parent_record_id",  "type": "string", "nullable": true},
    {"name": "parent_title",      "type": "string", "nullable": true},
    {"name": "title",             "type": "string"},
    {"name": "title_source",      "type": "enum",   "values": ["verbatim", "synthesized"],
     "note": "synthesized 表示源表没有标题字段，标题由本表自身字段拼出（不引入外部信息）"},
    {"name": "category",          "type": "string", "nullable": true, "note": "需求类别/类型/性质/品类"},
    {"name": "product_line",      "type": "string", "nullable": true},
    {"name": "sku",               "type": "string", "nullable": true},
    {"name": "status_raw",        "type": "string", "nullable": true, "note": "源系统原文，永不丢弃"},
    {"name": "status",            "type": "enum",   "values": ["未开始", "进行中", "已完成", "已停滞"],
     "nullable": true, "note": "归一后；无法归一保持 null 并计入 unnormalized_status"},
    {"name": "priority_raw",      "type": "string", "nullable": true},
    {"name": "priority_scale",    "type": "enum",   "values": ["P0P1P2", "eisenhower", null],
     "note": "两套体系互不相容，保留来源标记"},
    {"name": "priority",          "type": "string", "nullable": true, "note": "不跨体系比较"},
    {"name": "requester",         "type": "string", "nullable": true, "note": "提需人/需求人/需求方"},
    {"name": "owner",             "type": "string", "nullable": true, "note": "承接人/剪辑师/跟进人/执行人/专家"},
    {"name": "date_submitted",    "type": "date",   "nullable": true, "note": "Asia/Shanghai"},
    {"name": "date_due",          "type": "date",   "nullable": true},
    {"name": "date_done",         "type": "date",   "nullable": true},
    {"name": "due_source",        "type": "enum",   "values": ["planned", "flagged", null],
     "note": "planned=自己算；flagged=源系统已判定（仅 SEO 的「是否延期」）"},
    {"name": "deliverable",       "type": "string", "nullable": true},
    {"name": "notes",             "type": "string", "nullable": true},
    {"name": "extras",            "type": "object", "note": "未被上面消费的源字段，原样保留"}
  ],

  "status_normalization": {
    "未开始": ["未开始", "待开始", "未開始", "Not Started", "not started", "TODO"],
    "进行中": ["进行中", "推进中", "in progress", "In Progress", "In progress", "进行"],
    "已完成": ["已完成", "Done", "done", "DONE", "完成"],
    "已停滞": ["已停滞", "停滞", "阻塞", "Blocked"]
  },
  "status_normalization_notes": [
    "「推进中」与「进行中」是同一状态的不同叫法，合并。",
    "「已停滞」单独成态：只有 1 条，但它是唯一需要干预的状态，并入「进行中」会让它消失。",
    "未在表内的取值一律 status=null 并在验收报告里列出，不静默丢弃、不猜测。"
  ],

