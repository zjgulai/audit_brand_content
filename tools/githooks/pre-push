#!/bin/sh
# tools/githooks/pre-push —— T-142：让「推之前跑一次验收」成为可能
#
# 为什么是 pre-push 而不是 pre-commit：
#   `tools/verify_acceptance_run.py` 要跑 115 条映射，实测分钟级。
#   挂在 pre-commit 上会让每一次提交都变慢，于是**下一个人会把它绕过**——
#   而被绕过的钩子与没装过的钩子，效果完全一样。
#   pre-push 只在代码要离开本机时跑一次，代价与收益才对得上。
#
# ★ 这个文件受版本控制，但**不会自动生效**。安装要一行命令（见下），
#   而 `tools/verify_acceptance_trigger.py` 会把「装了 / 没装」分别报出来 ——
#   存在但未安装是一个**不同于「没有」**的状态，不许混为一谈。
#
# 安装（每个 clone 各做一次；`core.hooksPath` 不是版本控制的一部分）：
#
#     git config core.hooksPath tools/githooks
#
# 卸载：
#
#     git config --unset core.hooksPath
#
# 跳过一次（明知会红但必须先推上去时，**留痕**）：
#
#     SKIP_ACCEPTANCE=1 git push
#
# ★ 跳过必须留痕：下面会打印一行到 stderr，并把它写进 .git/SKIP-ACCEPTANCE.log。
#   这里的取舍是明确的——**允许跳过，但不允许悄悄跳过**。

set -u

LOG="$(git rev-parse --git-dir 2>/dev/null || echo .git)/SKIP-ACCEPTANCE.log"

if [ "${SKIP_ACCEPTANCE:-0}" = "1" ]; then
  _stamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  echo "⚠ SKIP_ACCEPTANCE=1 —— 本次推送**未跑**验收执行器（${_stamp}）" >&2
  echo "${_stamp}  skipped  user=$(git config user.name || echo unknown)" >> "$LOG" 2>/dev/null || true
  echo "  已记入 ${LOG}" >&2
  exit 0
fi

# 找仓库根：hook 的 cwd 不一定是根，`--show-toplevel` 才是准的。
_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "⚠ pre-push：读不到仓库根，跳过验收（这本身是一个缺陷，请修 hook）" >&2
  exit 0
}

_gate="$_root/tools/verify_acceptance_run.py"
if [ ! -f "$_gate" ]; then
  echo "⚠ pre-push：找不到 $_gate —— 跳过验收（**不是通过**）" >&2
  exit 0
fi

# 用 .venv 的解释器（验收执行器依赖 fastapi 等），没有就退回 python3。
if [ -x "$_root/.venv/bin/python" ]; then
  _py="$_root/.venv/bin/python"
else
  _py="python3"
fi

echo "pre-push：跑验收棘轮（failed=0 · 总数对 · passed 不倒退 —— 与 CI 同一判据）…" >&2
echo "  （跳过请用 SKIP_ACCEPTANCE=1 git push）" >&2

# ★★★ 2026-10-29：这里原来直接跑 `verify_acceptance_run.py` 并要求它 rc=0。
#
#   那个判据**永远不可能成立**，因为这个执行器把「未测」也算进退出码：
#   `if counts["untested"]: return 2`。而验收表里有 9 条是**文档逐条裁定**的
#   永久未测 —— 5 条「不该在此层：文档治理，不作为执行验收项 / 第一阶段按人工验收」
#   （#29 #43 #44 #55 #86，见 `tests/acceptance/untested-triage.md`），
#   4 条等 TanStack 迁移或等真人签收（#109 #110 #112 #128）。
#
#   实测证据：`.git/SKIP-ACCEPTANCE.log` 里 **28 次跳过、0 次真正放行** ——
#   这个钩子从装上（8e6f2a7，10-23）起就没有通过过一次。
#   而 `ratchet`（1a237bd，10-26）建立时没接进这里，于是两套判据并存：
#   CI 用棘轮（允许未测），钩子要求未测为 0。
#
#   ★ 「一个永远红的检查器」比没有检查器更糟 —— 它会让人习惯性跳过它，
#     于是真正的红也被一起跳过（AGENTS.md §2.1.1）。所以判据改成与 CI 一致：
#       · failed > 0            → 红，拦住
#       · 计数之和 ≠ 136        → 红（防「删几行所以看着没倒退」）
#       · passed < 地板         → 红（棘轮倒退）
#       · 未测                  → **允许**，但照样逐条打印出来
#     这三条在 `verify_acceptance_ratchet.py` 的 `--controls` 里各有反向对照。
#
#   ★ 没有降低标准：failed 这一条反而**更严**了 —— 旧写法在「有红」时也退 1，
#     但那时如果同时有未测，报出来的原因会是「未测」，红被混在里面；
#     现在红单独判，明细里直接说哪几条红。
_ratchet="$_root/tools/verify_acceptance_ratchet.py"
if [ ! -f "$_ratchet" ]; then
  echo "⚠ pre-push：找不到 $_ratchet —— **拦住**。" >&2
  echo "  找不到棘轮就退回裸跑执行器，会重新落入「永远过不去」的老毛病。" >&2
  exit 1
fi

"$_py" "$_ratchet" --run
_rc=$?

case "$_rc" in
  0)
    echo "✅ 验收棘轮成立（failed=0、总数对、passed 未倒退），放行。" >&2
    echo "   未测项按未测对待，不冒充通过 —— 明细见上面的执行器输出。" >&2
    exit 0
    ;;
  *)
    echo "❌ 验收棘轮退 $_rc —— 拦住。" >&2
    echo "  明细见上面输出；确需推送请 SKIP_ACCEPTANCE=1 git push（会留痕）。" >&2
    exit 1
    ;;
esac
