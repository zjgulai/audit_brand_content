{
  "name": "audit-review-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check_production_bundle.mjs",
    "preview": "vite preview",
    "verify:static": "bash scripts/gate.sh --stage static",
    "verify:build": "npm run build && bash scripts/gate.sh --stage build",
    "verify:visual": "node scripts/check_visual.mjs --check",
    "verify:a11y:manual": "node scripts/verify_manual_a11y.mjs",
    "verify:tokens": "node scripts/check_design_tokens.mjs --check",
    "verify:budget": "node scripts/check_bundle_budget.mjs --dir dist"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "@types/node": "^24.0.0"
  }
}
